# URL réelle uniquement. Sans domaine confirmé, les robots sont bloqués.
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=
# Secret aléatoire d'au moins 32 caractères pour le hachage des limites
RATE_LIMIT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Activer après validation de business.config.ts et des mentions légales
BUSINESS_VERIFIED=false
# Actifs sur Vercel ; désactivés hors Vercel pour les aperçus locaux.
# Utiliser false pour désactiver explicitement la collecte sur Vercel.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
ANALYTICS_PRIVACY_MODE=consent
# Exemption uniquement après évaluation documentée des critères CNIL.
ANALYTICS_EXEMPTION_VERIFIED=false
# Laisser vides pour conserver la politique existante, distincte de la recherche.
GPTBOT_POLICY=
GOOGLE_EXTENDED_POLICY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
